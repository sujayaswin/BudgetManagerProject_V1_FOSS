<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BudgetManagerProject" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">#FFB74D</item> <!-- Light Orange -->
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#FFE0B2</item>
        <item name="colorOnPrimaryContainer">#211000</item>

        <!-- Secondary color -->
        <item name="colorSecondary">#FF9800</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#FFCC80</item>
        <item name="colorOnSecondaryContainer">#2B1700</item>

        <!-- Surface and Background - FIXED to Light values -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">#424242</item>

        <item name="colorOnBackground">#000000</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">#FFA726</item>

        <!-- Control the color of icons -->
        <item name="colorControlNormal">#000000</item>

        <item name="android:textColorHint">#8A000000</item>

    </style>

    <!-- Custom Date Picker Theme - FIXED to Light values -->
    <style name="CustomDatePickerTheme" parent="Theme.Material3.Light.Dialog">
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorPrimary">#FFB74D</item>
        <item name="colorAccent">#FF9800</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
    </style>
</resources>
